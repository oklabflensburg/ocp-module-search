#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
VERSION=$(python -c 'import yaml; print(yaml.safe_load(open("module.yaml"))["version"])' 2>/dev/null || sed -n 's/^version: //p' "$ROOT/module.yaml")
OUT="$ROOT/dist/search-$VERSION.ocp"

cd "$ROOT/backend"
uv build --wheel
cd "$ROOT/frontend"
pnpm build
cd "$ROOT"
rm -rf dist/bundle
mkdir -p dist/bundle/backend dist/bundle/frontend
cp module.yaml dist/bundle/
cp backend/dist/*.whl dist/bundle/backend/
cp -R frontend/dist/. dist/bundle/frontend/
python - "$OUT" <<'PY'
import pathlib, sys, zipfile
root = pathlib.Path("dist/bundle")
out = pathlib.Path(sys.argv[1])
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as archive:
    for path in sorted(root.rglob("*")):
        if path.is_file():
            info = zipfile.ZipInfo(path.relative_to(root).as_posix(), (1980, 1, 1, 0, 0, 0))
            info.external_attr = 0o644 << 16
            archive.writestr(info, path.read_bytes(), compress_type=zipfile.ZIP_DEFLATED)
PY
sha256sum "$OUT" > "$OUT.sha256"
echo "$OUT"
